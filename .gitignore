# build output (npm run build: astro build + pagefind index in dist/pagefind)
dist/
.output/

# Astro's generated types and cache, recreated by astro dev/build
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables: .env.production holds the Umami settings, .env.report the Umami login for
# npm run report, and ops/umami/.env (created on the droplet) holds database passwords.
# Only the examples are committed.
.env
.env.*
!.env.example
!.env.*.example

# content health reports (npm run report): they include what readers searched for
reports/

# macOS-specific files
.DS_Store

# Windows-specific files
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# what scripts/indexnow.mjs last submitted, so it only sends changed pages
.indexnow-state.json
