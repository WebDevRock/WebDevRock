---
// Header search: a link to /search/ that opens a dialog when JavaScript is available.
// Shortcuts: "/" or Ctrl/Cmd+K.
---

<a href="/search/" class="search-trigger" data-search-open aria-haspopup="dialog">
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="search-trigger-label">Search</span>
  <kbd>/</kbd>
</a>

<dialog class="search-dialog" aria-labelledby="search-dialog-title" data-search-dialog>
  <div class="search-dialog-header">
    <h2 id="search-dialog-title">Search WebDevRock</h2>
    <button type="button" class="search-close" data-search-close aria-label="Close search">Esc</button>
  </div>
  <div id="search-dialog-ui" class="search-ui"></div>
</dialog>

<script>
  import { trackEvent } from '../scripts/analytics';
  import { mountSearch } from '../scripts/search';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const triggers = document.querySelectorAll<HTMLAnchorElement>('[data-search-open]'); // sidebar field, and the phone header button

  if (dialog && triggers.length) {
    const open = (from: string) => {
      if (dialog.open) return;
      dialog.showModal();
      trackEvent('search', { action: 'open', from });
      mountSearch('#search-dialog-ui', 'dialog');
    };

    triggers.forEach((trigger) =>
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open('button');
      }),
    );

    document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());

    // Close when clicking the backdrop
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      const typing = target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName);
      const shortcut = (event.key === '/' && !typing) || (event.key.toLowerCase() === 'k' && (event.ctrlKey || event.metaKey));
      if (!shortcut) return;
      event.preventDefault();
      open('shortcut');
    });
  }
</script>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px 7px 10px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-inset);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--text-body);
  }

  .search-trigger kbd {
    margin-left: auto;
  }

  .search-dialog {
    width: min(720px, calc(100vw - 2rem));
    max-height: min(80vh, 760px);
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    color: var(--text-body);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-dialog::backdrop {
    background: var(--surface-overlay);
    backdrop-filter: blur(3px);
  }

  .search-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-card);
  }

  .search-dialog-header h2 {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-close {
    min-width: 44px;
    min-height: 32px;
    padding: 2px 8px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--text-body);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }

  .search-dialog .search-ui {
    padding: 16px;
    overflow-y: auto;
  }

  @media (max-width: 960px) {
    .search-dialog {
      margin-top: 1rem;
      max-height: calc(100vh - 2rem);
    }
  }
</style>

<style is:global>
  /* Pagefind UI, themed with the design tokens (used by the dialog and /search/) */
  .search-ui {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text-strong);
    --pagefind-ui-background: var(--surface-raised);
    --pagefind-ui-border: var(--border-default);
    --pagefind-ui-tag: var(--surface-card);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 7px;
    --pagefind-ui-font: var(--font-sans);
  }

  .search-ui .pagefind-ui__result-link {
    color: var(--text-strong);
  }

  .search-ui .pagefind-ui__result-link:hover {
    color: var(--text-link-hover);
  }

  .search-ui .pagefind-ui__result-excerpt,
  .search-ui .pagefind-ui__message {
    color: var(--text-body);
  }

  .search-ui .pagefind-ui__filter-name,
  .search-ui .pagefind-ui__filter-label {
    color: var(--text-body);
  }

  /* More specific than Pagefind's own ".pagefind-ui--reset mark", which loads later */
  .search-ui .pagefind-ui--reset mark {
    background: var(--accent-tint);
    color: var(--verdigris-700);
    border-radius: 2px;
  }

  .search-unavailable {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
