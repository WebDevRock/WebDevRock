---
interface Props {
  title: string;
  href: string;
  tags?: string[];
  description?: string;
  label?: string; // small note above the title, e.g. "SQL Server 2016+"
}

const { title, href, tags, description, label } = Astro.props;
---

<a href={href} class="card">
  {label && <span class="label">{label}</span>}
  <h3>{title}</h3>
  {description && <p class="description">{description}</p>}
  {tags && tags.length > 0 && (
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  )}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
    color: var(--text-body);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .card:hover {
    background: var(--surface-raised);
    border-color: var(--border-default);
    box-shadow: var(--shadow-hover);
    color: var(--text-body);
  }

  .label {
    align-self: flex-start;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background: var(--type-snippets-bg);
    color: var(--type-snippets-fg);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
  }

  .card h3 {
    color: var(--text-strong);
    font-size: 17px;
    font-weight: 650;
    line-height: 1.3;
  }

  .card:hover h3 {
    color: var(--text-link-hover);
  }

  .description {
    flex: 1;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .tag {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .tag::before {
    content: '#';
    opacity: .6;
  }
</style>
