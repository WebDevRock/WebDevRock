---
// Tinted label naming a page's section, e.g. "Pattern", or "## Pattern" with its glyph
import { getSection } from '../lib/content';

interface Props {
  section: string;
  glyph?: boolean;
}

const section = getSection(Astro.props.section);
---

<span class="type-label" style={`--type-fg: ${section.accent}; --type-bg: ${section.tint}`}>
  {Astro.props.glyph && <span aria-hidden="true">{section.glyph} </span>}{section.singular}
</span>

<style>
  .type-label {
    display: inline-flex;
    flex-shrink: 0;
    align-self: flex-start;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    background: var(--type-bg);
    color: var(--type-fg);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
