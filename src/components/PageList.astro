---
// A bordered list of pages: type label, title, description and updated date
import TypeLabel from './TypeLabel.astro';
import { formatDate, type ContentPage } from '../lib/content';

interface Props {
  pages: ContentPage[];
  track: string; // Umami event target prefix, e.g. "recent" or "tag"
}

const { pages, track } = Astro.props;
---

<ul class="page-list">
  {pages.map((page) => (
    <li>
      <a href={page.path} data-umami-event="page-list-click" data-umami-event-target={`${track}-${page.slug}`}>
        <TypeLabel section={page.section} />
        <span class="text">
          <span class="title">{page.frontmatter.title}</span>
          {page.frontmatter.description && <span class="description">{page.frontmatter.description}</span>}
        </span>
        {page.frontmatter.updated && (
          <time class="date" datetime={page.frontmatter.updated}>{formatDate(page.frontmatter.updated)}</time>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .page-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
  }

  .page-list li {
    margin: 0;
  }

  .page-list li + li {
    border-top: 1px solid var(--border-subtle);
  }

  .page-list a {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 1.25rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .page-list a:hover {
    background: var(--bg-surface);
    text-decoration: none;
  }

  .page-list a:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: -2px;
  }

  .page-list :global(.type-label) {
    justify-self: start;
  }

  .text {
    display: grid;
    gap: 0.2rem;
  }

  .title {
    font-weight: 500;
  }

  .description {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .page-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
    }

    .date {
      order: -1;
    }
  }
</style>
