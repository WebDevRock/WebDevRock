---
// A bordered list of pages: type label, title, description and updated date
import TypeLabel from './TypeLabel.astro';
import { formatDate, type ContentPage } from '../lib/content';

interface Props {
  pages: ContentPage[];
  track: string; // Umami event target prefix, e.g. "recent" or "tag"
}

const { pages, track } = Astro.props;
---

<ul class="page-list">
  {pages.map((page) => (
    <li>
      <a href={page.path} data-umami-event="page-list-click" data-umami-event-target={`${track}-${page.slug}`}>
        <TypeLabel section={page.section} />
        <span class="text">
          <span class="title">{page.frontmatter.title}</span>
          {page.frontmatter.description && <span class="description">{page.frontmatter.description}</span>}
        </span>
        {page.frontmatter.updated && (
          <time class="date" datetime={page.frontmatter.updated}>{formatDate(page.frontmatter.updated)}</time>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .page-list {
    list-style: none;
    border-top: 1px solid var(--border-default);
  }

  .page-list a {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 12px 8px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-body);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .page-list a:hover {
    background: var(--surface-card);
    color: var(--text-body);
  }

  .text {
    display: grid;
    gap: 2px;
  }

  .title {
    color: var(--text-strong);
    font-weight: 600;
  }

  .description {
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .date {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .page-list a {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
      padding: 12px 4px;
    }

    .date {
      order: -1;
    }
  }
</style>
