---
// End-of-page navigation: learning path previous/next, then related pages by shared tags
import TypeLabel from './TypeLabel.astro';
import { byUpdated, getContentPages, getPathPositions, getRelatedPages, getSection } from '../lib/content';

interface Props {
  path: string; // normalised, e.g. /snippets/sql-bulk-update-join/
}

const { path } = Astro.props;
const positions = getPathPositions(path);

// Don't repeat pages already linked as previous/next
const linked = positions.flatMap((p) => [p.previous?.path, p.next?.path]).filter((p) => p !== undefined);
let related = getRelatedPages(path, 3, linked);
let relatedHeading = 'Related';

// No shared tags: fall back to the newest pages in the same section
const sectionKey = path.split('/')[1];
if (related.length === 0 && sectionKey) {
  related = getContentPages()
    .filter((p) => p.section === sectionKey && p.path !== path && !linked.includes(p.path))
    .sort(byUpdated)
    .slice(0, 3);
  relatedHeading = `More ${getSection(sectionKey)?.name ?? ''}`.trim();
}
---

{(positions.length > 0 || related.length > 0) && (
  <aside class="page-end" aria-label="Keep reading" data-pagefind-ignore>
    {positions.map((pos) => (
      <nav class="path-nav" aria-label={`${pos.title}: step ${pos.step} of ${pos.total}`}>
        <p class="path-label">
          <span class="path-kicker">Learning path</span>
          <span class="path-title">{pos.title}</span>
          <span class="path-step">Step {pos.step} of {pos.total}</span>
        </p>
        <div class="path-progress" aria-hidden="true">
          {Array.from({ length: pos.total }, (_, i) => <span class:list={{ done: i < pos.step }} />)}
        </div>
        <div class="path-links">
          {pos.previous ? (
            <a class="path-link previous" href={pos.previous.path} data-umami-event="next-step-click" data-umami-event-target={`previous-${pos.previous.slug}`}>
              <span class="direction">← Previous</span>
              <span class="link-title">{pos.previous.frontmatter.title}</span>
            </a>
          ) : (
            <span />
          )}
          {pos.next ? (
            <a class="path-link next" href={pos.next.path} data-umami-event="next-step-click" data-umami-event-target={`next-${pos.next.slug}`}>
              <span class="direction">Next step →</span>
              <span class="link-title">{pos.next.frontmatter.title}</span>
            </a>
          ) : (
            <a class="path-link next" href="/#start-here" data-umami-event="next-step-click" data-umami-event-target="path-complete">
              <span class="direction">Path complete ✓</span>
              <span class="link-title">Back to the learning paths</span>
            </a>
          )}
        </div>
      </nav>
    ))}

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">{relatedHeading}</h2>
        <ul>
          {related.map((page) => (
            <li>
              <a href={page.path} data-umami-event="related-click" data-umami-event-target={page.slug}>
                <TypeLabel section={page.section} />
                <span class="related-title">{page.frontmatter.title}</span>
                {page.frontmatter.description && <span class="related-description">{page.frontmatter.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </aside>
)}

<style>
  .page-end {
    display: grid;
    gap: 32px;
    margin-top: 48px;
  }

  /* Learning path: a compact strip with progress */
  .path-nav {
    padding: 14px 16px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .path-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  .path-kicker,
  .path-step {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .path-title {
    color: var(--text-strong);
    font-weight: 650;
  }

  .path-step {
    margin-left: auto;
  }

  .path-progress {
    display: flex;
    gap: 4px;
    margin: 12px 0 14px;
  }

  .path-progress span {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--border-default);
  }

  .path-progress span.done {
    background: var(--accent);
  }

  .path-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .path-link {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--text-strong);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .path-link.next {
    text-align: right;
  }

  .path-link:hover {
    border-color: var(--accent);
    color: var(--text-strong);
  }

  .direction {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .path-link.next .direction {
    color: var(--accent);
  }

  .link-title {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Related: ruled rows with the section glyph label */
  .related h2 {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related ul {
    margin-top: 8px;
    list-style: none;
    border-top: 1px solid var(--border-subtle);
  }

  .related a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 4px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-body);
    text-decoration: none;
  }

  .related-title {
    color: var(--text-strong);
    font-weight: 600;
    line-height: 1.4;
  }

  .related a:hover .related-title {
    color: var(--text-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-description {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .path-links {
      grid-template-columns: 1fr;
    }

    .path-link.next {
      order: -1;
      text-align: left;
    }

    .related a {
      grid-template-columns: 1fr;
    }

    .related-description {
      grid-column: 1;
    }
  }
</style>
