---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

// Automatically load all tools from .mdx and .astro files (excluding index.astro)
let tools = [];
try {
  const toolFiles = await Astro.glob('./*.{astro,mdx}');
  tools = toolFiles
    .filter(tool => !tool.file.endsWith('index.astro'))
    .map(tool => {
      // Extract filename without extension for href
      const filename = tool.file.split('/').pop()?.replace(/\.(astro|mdx)$/, '');
      
      return {
        title: tool.frontmatter.title,
        href: `/tools/${filename}`,
        tags: tool.frontmatter.tags || [],
        description: tool.frontmatter.description
      };
    })
    .sort((a, b) => a.title.localeCompare(b.title)); // Sort alphabetically by title
} catch (e) {
  // No content files found - tools remains empty array
}
---

<BaseLayout title="Tools" description="Browser-based utilities for SQL Server and integration work: list and JSON converters, a data fix script builder, a retry calculator, and a timestamp converter.">
  <div class="category-page">
    <div class="page-header">
      <h1>Tools</h1>
      <p>Small browser-based utilities for common tasks. JSON helpers, converters, testers, formatters.</p>
    </div>

    {tools.length > 0 ? (
      <div class="cards">
        {tools.map(tool => (
          <Card {...tool} />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No tools yet. Check back later.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-header p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 700px;
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
