---
// Full-page search, also the fallback for the header link. Supports /search/?q=term
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all of WebDevRock: SQL Server snippets, integration patterns, browser tools, and practical guides to AI agents and local LLMs.">
  <div class="search-page">
    <header class="page-title">
      <h1>Search</h1>
      <p>Search every pattern, snippet, tool and guide. Press <kbd>/</kbd> on any page to search from there.</p>
    </header>
    <div id="search-page-ui" class="search-ui">
      <noscript><p class="search-unavailable">Search needs JavaScript. You can also browse by <a href="/tags/">tag</a>.</p></noscript>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountSearch } from '../scripts/search';

  const term = new URLSearchParams(location.search).get('q') ?? '';
  mountSearch('#search-page-ui', 'page', term);
</script>

<style>
  .search-page {
    max-width: 820px;
  }

  .page-title {
    margin-bottom: 28px;
  }

  .search-page .search-ui {
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }
</style>
