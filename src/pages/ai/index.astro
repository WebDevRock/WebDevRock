---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

// Automatically load all AI articles from .mdx files
let articles = [];
try {
  const articleFiles = await Astro.glob('./*.mdx');
  articles = articleFiles.map(article => {
    const filename = article.file.split('/').pop()?.replace('.mdx', '');
    const level = article.frontmatter.level || 'intermediate';
    return {
      title: article.frontmatter.title,
      href: `/ai/${filename}`,
      tags: [...(article.frontmatter.tags || []), level],
      description: article.frontmatter.description
    };
  }).sort((a, b) => {
    const levelOrder = { beginner: 0, intermediate: 1, advanced: 2 };
    const aLevel = a.tags.find(t => levelOrder.hasOwnProperty(t)) || 'intermediate';
    const bLevel = b.tags.find(t => levelOrder.hasOwnProperty(t)) || 'intermediate';
    return levelOrder[aLevel] - levelOrder[bLevel];
  });
} catch (e) {
  // No .mdx files found
}

const beginnerArticles = articles.filter(a => a.tags.includes('beginner'));
const advancedArticles = articles.filter(a => a.tags.includes('advanced'));
---

<BaseLayout title="AI &amp; LLM Workflows" description="Practical guides on using AI agents, local LLMs, and automation to organise your work and life. Hands-on workflows, not machine learning theory.">
  <div class="category-page">
    <div class="page-header">
      <h1>AI &amp; LLM Workflows</h1>
      <p>Practical guides on using AI agents, local LLMs, and automation to organise your work and life. No machine learning theory, just hands-on workflows I've built and use daily.</p>
    </div>

    {beginnerArticles.length > 0 && (
      <section class="article-section">
        <h2>Getting Started</h2>
        <div class="cards">
          {beginnerArticles.map(article => (
            <Card {...article} />
          ))}
        </div>
      </section>
    )}

    {advancedArticles.length > 0 && (
      <section class="article-section">
        <h2>Advanced Setup</h2>
        <div class="cards">
          {advancedArticles.map(article => (
            <Card {...article} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-header p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 700px;
  }

  .article-section {
    margin-bottom: 3rem;
  }

  .article-section h2 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
