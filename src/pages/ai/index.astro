---
// AI guides in two groups by their front matter level: beginner and intermediate first, then advanced
import SectionIndex from '../../components/SectionIndex.astro';
import { getContentPages } from '../../lib/content';

const guides = getContentPages()
  .filter((p) => p.section === 'ai')
  .sort((a, b) => a.frontmatter.title.localeCompare(b.frontmatter.title));
const groups = [
  { heading: 'Getting started', pages: guides.filter((p) => p.frontmatter.level !== 'advanced') },
  { heading: 'Advanced setup', pages: guides.filter((p) => p.frontmatter.level === 'advanced') },
].filter((g) => g.pages.length > 0);
---

<SectionIndex
  section="ai"
  title="AI & LLM Workflows"
  description="Practical guides on using AI agents, local LLMs, and automation to organise your work and life. Hands-on workflows, not machine learning theory."
  intro="Practical guides on using AI agents, local LLMs, and automation to organise your work and life. No machine learning theory, just hands-on workflows I've built and use daily."
  groups={groups}
/>
