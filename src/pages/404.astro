---
// Built as dist/404.html; nginx serves it for any missing URL (error_page in ops/nginx/webdevrock.uk.conf).
// The address bar still shows the missing URL, so the script reads it to pre-fill the search.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, getContentPages } from '../lib/content';

const pages = getContentPages();
const countFor = (key: string) => pages.filter((p) => p.section === key).length;
---

<BaseLayout title="Page not found" description="This page doesn't exist on WebDevRock." noindex>
  <div class="not-found">
    <section class="intro">
      <p class="code" aria-hidden="true"><span class="prompt">$</span> GET <span data-missing-path>/this-page</span> <span class="status">404</span></p>
      <h1>This page doesn't exist</h1>
      <p class="lead">
        It may have moved, or the link may be mistyped. Try a search, or pick up from one of the sections below.
      </p>
    </section>

    <section class="search-block" aria-labelledby="nf-search-heading">
      <h2 id="nf-search-heading" class="block-title">Search the site</h2>
      <div id="not-found-search" class="search-ui">
        <noscript><p class="search-unavailable">Search needs JavaScript. You can also browse by <a href="/tags/">tag</a>.</p></noscript>
      </div>
    </section>

    <section aria-labelledby="nf-sections-heading">
      <h2 id="nf-sections-heading" class="block-title">Or browse a section</h2>
      <div class="section-grid">
        {SECTIONS.map((section) => (
          <a
            class="section-tile"
            href={`/${section.key}/`}
            style={`--type-fg: ${section.accent}; --type-bg: ${section.tint}`}
            data-umami-event="not-found-click"
            data-umami-event-target={`section-${section.key}`}
          >
            <span class="tile-glyph" aria-hidden="true">{section.glyph}</span>
            <span class="tile-name">{section.name}</span>
            <span class="tile-count">{countFor(section.key)} {countFor(section.key) === 1 ? 'page' : 'pages'}</span>
          </a>
        ))}
      </div>
      <p class="more-links">
        <a href="/" data-umami-event="not-found-click" data-umami-event-target="home">Home</a>
        <a href="/tags/" data-umami-event="not-found-click" data-umami-event-target="tags">All tags</a>
        <a href="/#start-here" data-umami-event="not-found-click" data-umami-event-target="start-here">Learning paths</a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { trackEvent } from '../scripts/analytics';
  import { mountSearch } from '../scripts/search';

  const path = location.pathname;
  const shown = document.querySelector('[data-missing-path]');
  if (shown) shown.textContent = path.length > 60 ? `${path.slice(0, 57)}...` : path;

  // Words from the missing URL make a reasonable first search, e.g. /patterns/reversable-data-fix -> "reversable data fix"
  const ignore = new Set(['patterns', 'snippets', 'tools', 'ai', 'experiments', 'tags', 'index', 'html', 'md']);
  const term = decodeURIComponent(path)
    .split(/[/\-_.\s]+/)
    .filter((word) => word && !ignore.has(word.toLowerCase()))
    .join(' ')
    .slice(0, 80);

  trackEvent('not-found', { path, referrer: document.referrer ? new URL(document.referrer).hostname : 'direct' });
  mountSearch('#not-found-search', 'not-found', term);
</script>

<style>
  .not-found {
    max-width: 860px;
    padding-top: 16px;
  }

  .intro {
    margin-bottom: 40px;
  }

  .code {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 100%;
    margin-bottom: 20px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    background: var(--surface-code);
    color: var(--syn-text);
    font-family: var(--font-mono);
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--syn-keyword);
  }

  .status {
    color: var(--syn-string);
    font-weight: 600;
  }

  h1 {
    color: var(--text-strong);
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
  }

  .lead {
    max-width: 58ch;
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 17px;
  }

  .block-title {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-strong);
    font-size: 17px;
    font-weight: 650;
  }

  .search-block {
    margin-bottom: 40px;
  }

  .search-block .search-ui {
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }

  .section-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--text-strong);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .section-tile:hover {
    background: var(--surface-raised);
    box-shadow: var(--shadow-hover);
    color: var(--text-strong);
  }

  .tile-glyph {
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--type-bg);
    color: var(--type-fg);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }

  .tile-name {
    font-weight: 650;
  }

  .tile-count {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 20px;
    font-weight: 500;
  }
</style>
