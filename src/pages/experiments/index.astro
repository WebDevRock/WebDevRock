---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

// Automatically load all experiments from .mdx and .astro files (excluding index.astro)
let experiments = [];
try {
  const experimentFiles = await Astro.glob('./*.{astro,mdx}');
  experiments = experimentFiles
    .filter(exp => !exp.file.endsWith('index.astro'))
    .map(exp => {
      // Extract filename without extension for href
      const filename = exp.file.split('/').pop()?.replace(/\.(astro|mdx)$/, '');
      
      return {
        title: exp.frontmatter.title,
        href: `/experiments/${filename}`,
        tags: exp.frontmatter.tags || [],
        description: exp.frontmatter.description
      };
    })
    .sort((a, b) => a.title.localeCompare(b.title)); // Sort alphabetically by title
} catch (e) {
  // No content files found - experiments remains empty array
}
---

<BaseLayout title="Experiments" description="Visual and technical experiments. Some incomplete, some exploratory.">
  <div class="category-page">
    <div class="page-header">
      <h1>Experiments</h1>
      <p>Visual or technical experiments. Some incomplete, some exploratory. Things that may or may not evolve into something useful.</p>
    </div>

    <div class="cards">
      {experiments.map(exp => (
        <Card {...exp} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-header p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 700px;
  }

  .cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
