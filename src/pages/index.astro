---
// Homepage (design concept D, "Workbench"): a command palette for the common tasks that filters every page as
// you type, then the learning paths, recent updates and tools. Sections are in the sidebar.
import BaseLayout from '../layouts/BaseLayout.astro';
import TypeLabel from '../components/TypeLabel.astro';
import { HOME_TASKS, LEARNING_PATHS, SECTIONS, byUpdated, formatDate, getContentPages, getSection, learningPathId } from '../lib/content';

const pages = getContentPages();
const byPath = new Map(pages.map((p) => [p.path, p]));

const recent = pages.filter((p) => p.frontmatter.updated).sort(byUpdated).slice(0, 6);
const lastUpdated = recent[0]?.frontmatter.updated;

const tasks = HOME_TASKS.filter((t) => byPath.has(t.path));
const taskPaths = new Set(tasks.map((t) => t.path));

const paths = LEARNING_PATHS.map((p) => ({
  ...p,
  steps: p.steps.map((path) => byPath.get(path)).filter((s) => s !== undefined),
}));

const tools = pages.filter((p) => p.section === 'tools');

// What the palette matches against: title, description and tags
const searchText = (p: (typeof pages)[number], extra = '') =>
  [extra, p.frontmatter.title, p.frontmatter.description, ...(p.frontmatter.tags ?? [])].join(' ').toLowerCase();
---

<BaseLayout
  title="Home"
  fullTitle="WebDevRock: SQL Server Scripts, Patterns and Tools"
  description="SQL Server scripts, integration patterns and browser tools for working inside existing systems: messy data, limited schema control, and the need to be reliable."
>
  <div class="home">
    <header class="intro">
      <p class="micro-label">
        {pages.length} guides, snippets and tools{lastUpdated && <> · updated {formatDate(lastUpdated)}</>}
      </p>
      <h1>Practical patterns for <em>real-world</em> development</h1>
      <p class="lead">
        Most development happens inside existing systems. Scripts, patterns and tools shaped by real constraints:
        messy data, limited schema control, and the need to be reliable.
      </p>
    </header>

    <!-- Command palette: the task shortcuts until you type, then every page that matches -->
    <section class="palette" aria-labelledby="palette-title" data-pagefind-ignore>
      <label class="palette-input">
        <span class="prompt" aria-hidden="true"></span>
        <span id="palette-title" class="visually-hidden">What are you trying to do?</span>
        <input type="text" placeholder="What are you trying to do?" autocomplete="off" spellcheck="false" data-palette-input />
        <kbd class="enter-hint">↵ open</kbd>
      </label>
      <ul class="palette-list" data-palette-list>
        {tasks.map((t) => {
          const page = byPath.get(t.path)!;
          return (
            <li data-task data-search={searchText(page, t.label)}>
              <a href={t.path} data-umami-event="home-click" data-umami-event-target={`task-${page.slug}`}>
                <span class="row-icon" aria-hidden="true">↳</span>
                <span class="item-title">{t.label}</span>
                <TypeLabel section={page.section} />
              </a>
            </li>
          );
        })}
        {pages.filter((p) => !taskPaths.has(p.path)).map((p) => (
          <li data-page hidden data-search={searchText(p)}>
            <a href={p.path} data-umami-event="home-click" data-umami-event-target={`palette-${p.slug}`}>
              <span class="glyph" style={`--type-fg: ${getSection(p.section).accent}; --type-bg: ${getSection(p.section).tint}`} aria-hidden="true">{getSection(p.section).glyph}</span>
              <span class="item-title">{p.frontmatter.title}</span>
              <TypeLabel section={p.section} />
            </a>
          </li>
        ))}
      </ul>
      <p class="palette-empty" data-palette-empty hidden>
        Nothing here matches. <a href="/search/" data-palette-search>Search the whole site</a>
      </p>
    </section>

    <div class="columns">
      <section class="paths" id="start-here" aria-labelledby="paths-title">
        <h2 id="paths-title" class="col-title">Start here</h2>
        <p class="col-note">Read in order: each step builds on the one before.</p>
        {paths.map((p) => (
          <div class="path" id={learningPathId(p.title)}>
            <h3 class="micro-label">{p.title}</h3>
            <ol>
              {p.steps.map((s) => (
                <li>
                  <a href={s.path} data-umami-event="home-click" data-umami-event-target={`path-${s.slug}`}>
                    <span class="item-title">{s.frontmatter.title}</span>
                    <TypeLabel section={s.section} />
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>

      <section aria-labelledby="recent-title">
        <h2 id="recent-title" class="col-title">Recently updated</h2>
        <div class="table-wrap">
          <table class="recent">
            <thead>
              <tr><th scope="col">Page</th><th scope="col">Type</th><th scope="col">Updated</th></tr>
            </thead>
            <tbody>
              {recent.map((p) => (
                <tr>
                  <td><a href={p.path} data-umami-event="page-list-click" data-umami-event-target={`recent-${p.slug}`}>{p.frontmatter.title}</a></td>
                  <td><TypeLabel section={p.section} /></td>
                  <td class="date">{p.frontmatter.updated && formatDate(p.frontmatter.updated)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="col-title tools-title">Tools <span class="note">run in your browser; nothing you paste is sent anywhere</span></h2>
        <ul class="tools">
          {tools.map((t) => (
            <li>
              <a href={t.path} data-umami-event="home-click" data-umami-event-target={`tool-${t.slug}`}>
                <span class="slug">&gt;_ {t.slug}</span>
                <span class="tool-desc">{t.frontmatter.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="sections" aria-labelledby="sections-title">
      <h2 id="sections-title" class="col-title">Browse by section</h2>
      <ul>
        {SECTIONS.map((s) => (
          <li>
            <a href={`/${s.key}/`} style={`--type-fg: ${s.accent}; --type-bg: ${s.tint}`} data-umami-event="home-click" data-umami-event-target={`section-${s.key}`}>
              <span class="glyph" aria-hidden="true">{s.glyph}</span>
              <span class="section-name">{s.name}</span>
              <span class="section-desc">{s.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const list = document.querySelector<HTMLElement>('[data-palette-list]');
  const empty = document.querySelector<HTMLElement>('[data-palette-empty]');
  const searchLink = document.querySelector<HTMLAnchorElement>('[data-palette-search]');

  if (input && list && empty && searchLink) {
    const items = [...list.querySelectorAll<HTMLLIElement>('li')];

    input.addEventListener('input', () => {
      const query = input.value.trim();
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const item of items) {
        const match = words.length
          ? words.every((w) => item.dataset.search!.includes(w)) && shown < 8
          : item.hasAttribute('data-task');
        item.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
      searchLink.href = query ? `/search/?q=${encodeURIComponent(query)}` : '/search/';
      searchLink.textContent = query ? `Search the whole site for “${query}”` : 'Search the whole site';
    });

    // Enter opens the first match, or the full search when nothing matches
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      const first = items.find((i) => !i.hidden)?.querySelector('a');
      location.href = first ? first.href : searchLink.href;
    });
  }
</script>

<style>
  .home {
    max-width: var(--content-max);
  }

  .intro h1 {
    max-width: 22ch;
    margin-top: 8px;
    color: var(--text-strong);
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
  }

  .intro em {
    color: var(--accent);
    font-family: var(--font-serif-italic);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .lead {
    max-width: 60ch;
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 17px;
  }

  /* Palette */
  .palette {
    margin-top: 32px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .palette-input {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .palette-input:focus-within {
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
  }

  .palette-input input {
    flex: 1;
    min-width: 0;
    padding: 18px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text-strong);
    font: 500 19px var(--font-sans);
  }

  .palette-input input:focus-visible {
    box-shadow: none;
  }

  .palette-input input::placeholder {
    color: var(--text-muted);
  }

  .enter-hint {
    white-space: nowrap;
  }

  .palette-list {
    padding: 6px;
    list-style: none;
  }

  .palette-list a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    color: var(--text-strong);
    font-weight: 500;
    text-decoration: none;
  }

  .palette-list a:hover,
  .palette-list a:focus-visible,
  .palette-list li:first-child:not([hidden]) a {
    background: var(--surface-card);
    color: var(--text-strong);
  }

  .row-icon {
    width: 26px;
    color: var(--text-muted);
    text-align: center;
  }

  .item-title {
    flex: 1;
    min-width: 0;
  }

  .glyph {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 22px;
    border-radius: var(--radius-sm);
    background: var(--type-bg);
    color: var(--type-fg);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
  }

  .palette-empty {
    padding: 14px 16px;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  /* Columns */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 40px;
    margin-top: 48px;
  }

  .col-title {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-strong);
    font-size: 17px;
    font-weight: 650;
  }

  .col-note,
  .note {
    color: var(--text-muted);
    font-size: 13.5px;
    font-weight: 400;
  }

  .col-note {
    margin-top: 8px;
  }

  .note {
    margin-left: 6px;
  }

  .paths,
  .path {
    scroll-margin-top: 80px;
  }

  .path {
    margin-top: 18px;
  }

  .path ol {
    margin-top: 8px;
    list-style: none;
    counter-reset: step;
  }

  .path li {
    counter-increment: step;
  }

  .path a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    color: var(--text-strong);
    font-size: 15px;
    text-decoration: none;
  }

  .path a::before {
    content: counter(step);
    flex: none;
    width: 20px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .path a:hover .item-title {
    color: var(--text-link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .recent {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .recent th {
    padding: 10px 8px 6px 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
  }

  .recent td {
    padding: 9px 8px 9px 0;
    border-top: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .recent td a {
    color: var(--text-strong);
    font-weight: 500;
    text-decoration: none;
  }

  .recent td a:hover {
    color: var(--text-link-hover);
    text-decoration: underline;
  }

  .date {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    white-space: nowrap;
  }

  .tools-title {
    margin-top: 36px;
  }

  .tools {
    list-style: none;
  }

  .tools a {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
  }

  .tools a:hover .slug {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .slug {
    color: var(--type-tools-fg);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Sections, for readers who land here first */
  .sections {
    margin-top: 48px;
  }

  .sections ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 16px;
    list-style: none;
  }

  .sections a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    color: var(--text-body);
    text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .sections a:hover {
    background: var(--surface-raised);
    box-shadow: var(--shadow-hover);
    color: var(--text-body);
  }

  .section-name {
    color: var(--text-strong);
    font-weight: 650;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 13.5px;
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .intro h1 {
      font-size: 32px;
    }

    .columns {
      grid-template-columns: 1fr;
    }

    .enter-hint,
    .palette-list :global(.type-label) {
      display: none;
    }

    .tools a {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .recent th:nth-child(2),
    .recent td:nth-child(2) {
      display: none;
    }
  }
</style>
