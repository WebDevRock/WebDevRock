---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageList from '../components/PageList.astro';
import TypeLabel from '../components/TypeLabel.astro';
import { LEARNING_PATHS, SECTIONS, byUpdated, formatDate, getContentPages } from '../lib/content';

const pages = getContentPages();
const byPath = new Map(pages.map((p) => [p.path, p]));
const countFor = (key: string) => pages.filter((p) => p.section === key).length;

const recent = pages.filter((p) => p.frontmatter.updated).sort(byUpdated).slice(0, 6);
const lastUpdated = recent[0]?.frontmatter.updated;

// "What are you trying to do?" entry points
const tasks = [
  { label: 'Fix data in production without risking it', path: '/patterns/sql-reversible-data-fix/' },
  { label: 'Update or delete millions of rows', path: '/snippets/sql-batch-update-delete/' },
  { label: 'Turn a spreadsheet list into SQL', path: '/tools/list-to-sql/' },
  { label: 'Read a JSON payload in SQL Server', path: '/tools/json-to-openjson/' },
  { label: 'Stop an integration creating duplicates', path: '/patterns/integration-jobs-safe-to-rerun/' },
  { label: 'Retry a flaky API without hammering it', path: '/patterns/handling-unreliable-external-apis/' },
].filter((t) => byPath.has(t.path));

const paths = LEARNING_PATHS.map((p) => ({
  ...p,
  steps: p.steps.map((path) => byPath.get(path)).filter((s) => s !== undefined),
}));

const tools = pages.filter((p) => p.section === 'tools');
---

<BaseLayout
  title="Home"
  description="A working knowledge base of SQL Server scripts, integration patterns, browser tools, and experiments, shaped by real constraints: messy data, limited schema control, and the need to be reliable."
>
  <div class="home">
    <!-- Hero: what the site is, plus task-based ways in -->
    <section class="hero">
      <div class="hero-intro">
        <p class="hero-badge">
          {pages.length} guides, snippets and tools{lastUpdated && <> · updated {formatDate(lastUpdated)}</>}
        </p>
        <h1>Practical patterns for <em>real-world</em> development</h1>
        <p class="hero-description">
          Most development happens inside existing systems. Scripts, patterns and tools shaped by real constraints:
          messy data, limited schema control, and the need to be reliable.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/patterns/" data-umami-event="home-click" data-umami-event-target="hero-patterns">
            Explore the patterns
          </a>
          <a class="button" href="/tools/" data-umami-event="home-click" data-umami-event-target="hero-tools">
            Open the tools
          </a>
        </div>
      </div>

      <section class="task-panel" aria-labelledby="task-heading">
        <h2 id="task-heading" class="panel-title"><span aria-hidden="true">$</span> What are you trying to do?</h2>
        <ul>
          {tasks.map((task) => {
            const page = byPath.get(task.path)!;
            return (
              <li>
                <a href={task.path} data-umami-event="home-click" data-umami-event-target={`task-${page.slug}`}>
                  <span class="task-label">{task.label}</span>
                  <TypeLabel section={page.section} />
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </section>

    <!-- Sections -->
    <section class="block" aria-labelledby="sections-heading">
      <div class="block-header">
        <h2 id="sections-heading" class="block-title">Browse by section</h2>
        <a class="block-link" href="/tags/" data-umami-event="home-click" data-umami-event-target="all-tags">Browse by tag →</a>
      </div>
      <div class="section-grid">
        {SECTIONS.map((section) => (
          <a
            class="section-tile"
            href={`/${section.key}/`}
            style={`--accent: ${section.accent}`}
            data-umami-event="home-click"
            data-umami-event-target={`section-${section.key}`}
          >
            <span class="tile-glyph" aria-hidden="true">{section.glyph}</span>
            <span class="tile-name">{section.name}</span>
            <span class="tile-count">{countFor(section.key)} {countFor(section.key) === 1 ? 'page' : 'pages'}</span>
            <span class="tile-description">{section.description}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Learning paths -->
    <section class="block" id="start-here" aria-labelledby="paths-heading">
      <div class="block-header">
        <h2 id="paths-heading" class="block-title">Start here</h2>
        <p class="block-note">Read in order: each step builds on the one before.</p>
      </div>
      <div class="path-grid">
        {paths.map((path) => (
          <article class="path-card">
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <ol class="path-steps">
              {path.steps.map((step) => (
                <li>
                  <a href={step.path} data-umami-event="home-click" data-umami-event-target={`path-${step.slug}`}>
                    <span class="step-title">{step.frontmatter.title}</span>
                    <TypeLabel section={step.section} />
                  </a>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>

    <!-- Tools -->
    <section class="block" aria-labelledby="tools-heading">
      <div class="block-header">
        <h2 id="tools-heading" class="block-title">Tools</h2>
        <a class="block-link" href="/tools/">All tools →</a>
      </div>
      <p class="block-intro">Run entirely in your browser. Nothing you paste is sent anywhere.</p>
      <div class="tool-grid">
        {tools.map((tool) => (
          <a class="tool-tile" href={tool.path} data-umami-event="home-click" data-umami-event-target={`tool-${tool.slug}`}>
            <span class="tool-command"><span aria-hidden="true">&gt;_ </span>{tool.slug}</span>
            <span class="tool-title">{tool.frontmatter.title}</span>
            <span class="tool-description">{tool.frontmatter.description}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Recently updated -->
    <section class="block" aria-labelledby="recent-heading">
      <div class="block-header">
        <h2 id="recent-heading" class="block-title">Recently updated</h2>
      </div>
      <PageList pages={recent} track="recent" />
    </section>

    <!-- About -->
    <section class="about">
      <p>
        Written from day-to-day work on operational systems: SQL Server, integrations, and the tools around them.
        Every page is also available as Markdown for AI tools; see <a href="/llms.txt">llms.txt</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 1100px;
    margin: 0 auto;
    overflow-x: clip; /* the hero glows extend past the edges; don't let them cause sideways scrolling */
  }

  /* Hero */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding: 4rem 0 5rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: -10%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(255, 107, 107, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: -12%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-intro,
  .task-panel {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
  }

  .hero-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent-lime);
    border-radius: 50%;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .hero h1 em {
    font-style: italic;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .button:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--gradient-1);
    border-color: transparent;
    color: var(--bg-deep);
    font-weight: 600;
  }

  /* Task panel */
  .task-panel {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .panel-title span {
    color: var(--accent-lime);
  }

  .task-panel ul {
    list-style: none;
    display: grid;
    gap: 0.375rem;
  }

  .task-panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.875rem;
    border-radius: 10px;
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .task-panel a:hover {
    background: var(--bg-hover);
  }

  .task-label {
    font-size: 0.95rem;
  }

  /* Blocks */
  .block {
    padding: 3.5rem 0;
  }

  .block-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .block-title {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  .block-note,
  .block-intro {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .block-intro {
    margin: -0.75rem 0 1.5rem;
  }

  .block-link {
    color: var(--accent-coral);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .block-link:hover {
    text-decoration: underline;
  }

  /* Section tiles */
  .section-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .section-tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-top: 3px solid var(--accent);
    border-radius: 14px;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .section-tile:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .tile-glyph {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .tile-name {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .tile-count {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tile-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Learning paths */
  .path-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .path-card {
    padding: 1.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
  }

  .path-card h3 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .path-card > p {
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .path-steps {
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 0.25rem;
  }

  .path-steps li {
    counter-increment: step;
  }

  .path-steps a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.5rem;
    border-radius: 10px;
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .path-steps a::before {
    content: counter(step);
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .path-steps a:hover {
    background: var(--bg-hover);
  }

  .step-title {
    flex: 1;
    font-size: 0.95rem;
  }

  /* Tools */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .tool-tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .tool-tile:hover {
    border-color: var(--accent-cyan);
  }

  .tool-command {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
  }

  .tool-title {
    font-weight: 600;
  }

  .tool-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* About */
  .about {
    padding: 2rem 0 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 680px;
  }

  .about a {
    color: var(--link);
  }

  /* Focus */
  .home a:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 2px;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2.5rem 0 3.5rem;
    }

    .section-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 2.25rem;
    }

    .hero-description {
      font-size: 1.05rem;
    }

    .hero-actions .button {
      flex: 1;
      justify-content: center;
    }

    .section-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .section-tile {
      transition: none;
    }

    .button:hover,
    .section-tile:hover {
      transform: none;
    }
  }
</style>
