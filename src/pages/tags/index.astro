---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/content';

const tags = getTags();
const alphabetical = [...tags].sort((a, b) => a.slug.localeCompare(b.slug));
const popular = tags.filter((t) => t.pages.length > 1).slice(0, 12);
---

<BaseLayout title="Tags" description="Browse WebDevRock's patterns, snippets, tools and guides by topic.">
  <div class="tags-page">
    <header class="page-title">
      <h1>Tags</h1>
      <p>Every topic across patterns, snippets, tools and guides. The number is how many pages use the tag.</p>
    </header>

    {popular.length > 0 && (
      <section aria-labelledby="popular-heading">
        <h2 id="popular-heading" class="block-title">Most used</h2>
        <ul class="tag-cloud">
          {popular.map((tag) => (
            <li>
              <a class="tag-chip large" href={`/tags/${tag.slug}/`} data-umami-event="tag-click" data-umami-event-target={`index-popular-${tag.slug}`}>
                #{tag.label}<span class="count">{tag.pages.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section aria-labelledby="all-heading">
      <h2 id="all-heading" class="block-title">All tags (A to Z)</h2>
      <ul class="tag-cloud">
        {alphabetical.map((tag) => (
          <li>
            <a class="tag-chip" href={`/tags/${tag.slug}/`} data-umami-event="tag-click" data-umami-event-target={`index-${tag.slug}`}>
              #{tag.label}<span class="count">{tag.pages.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .tags-page {
    max-width: var(--content-max);
  }

  .page-title {
    margin-bottom: 32px;
  }

  section + section {
    margin-top: 36px;
  }

  .block-title {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-default);
    color: var(--text-strong);
    font-size: 17px;
    font-weight: 650;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 3px 11px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    color: var(--text-body);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .tag-chip.large {
    min-height: 38px;
    padding: 5px 14px;
    background: var(--surface-card);
    color: var(--text-strong);
    font-size: 14px;
  }

  .tag-chip:hover {
    border-color: var(--accent);
    color: var(--text-strong);
  }

  .count {
    color: var(--text-muted);
    font-size: 11.5px;
  }
</style>
