---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageList from '../../components/PageList.astro';
import { SECTIONS, byUpdated, getTags, type TagInfo } from '../../lib/content';

export function getStaticPaths() {
  return getTags().map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

interface Props {
  tag: TagInfo;
}

const { tag } = Astro.props;
const pages = [...tag.pages].sort(byUpdated);

// "3 patterns, 2 snippets and 1 tool"
const counts = SECTIONS.map((s) => ({ section: s, count: pages.filter((p) => p.section === s.key).length })).filter((c) => c.count > 0);
const parts = counts.map(({ section, count }) => {
  const noun = count === 1 ? section.singular.toLowerCase() : section.name.toLowerCase();
  return `${count} ${section.key === 'ai' ? (count === 1 ? 'AI guide' : 'AI guides') : noun}`;
});
const summary = parts.length > 1 ? `${parts.slice(0, -1).join(', ')} and ${parts.at(-1)}` : parts[0];

// Other tags used on these pages, as a way to move sideways
const paths = new Set(pages.map((p) => p.path));
const otherTags = getTags()
  .filter((t) => t.slug !== tag.slug && t.pages.some((p) => paths.has(p.path)))
  .slice(0, 12);
---

<BaseLayout title={`#${tag.label}`} description={`${summary} tagged ${tag.label} on WebDevRock.`}>
  <div class="tag-page">
    <header class="page-title">
      <p class="micro-label">Tag</p>
      <h1>#{tag.label}</h1>
      <p>{summary}.</p>
    </header>

    <PageList pages={pages} track={`tag-${tag.slug}`} />

    {otherTags.length > 0 && (
      <section class="related-tags" aria-labelledby="related-tags-heading">
        <h2 id="related-tags-heading">Related tags</h2>
        <ul>
          {otherTags.map((t) => (
            <li>
              <a href={`/tags/${t.slug}/`} data-umami-event="tag-click" data-umami-event-target={`related-${t.slug}`}>#{t.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .tag-page {
    max-width: 900px;
  }

  .page-title {
    margin-bottom: 28px;
  }

  .page-title h1 {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .related-tags {
    margin-top: 40px;
  }

  .related-tags h2 {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
    list-style: none;
  }

  .related-tags a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 3px 11px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    color: var(--text-body);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
  }

  .related-tags a:hover {
    border-color: var(--accent);
    color: var(--text-strong);
  }
</style>
