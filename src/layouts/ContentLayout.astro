---
import BaseLayout from './BaseLayout.astro';
import ChecksChecklist from '../components/ChecksChecklist.astro';
import CopyMarkdown from '../components/CopyMarkdown.astro';
import PageEndNav from '../components/PageEndNav.astro';
import PageFeedback from '../components/PageFeedback.astro';
import PlaceholderPanel from '../components/PlaceholderPanel.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TypeLabel from '../components/TypeLabel.astro';
import { SECTIONS, formatDate, normalisePath, readingMinutes, sqlVersionLabel, sqlVersionsFrom, tagPath, type Frontmatter } from '../lib/content';
import type { Placeholder } from '../scripts/placeholders';
import '../styles/content.css';

interface Props {
  // MDX parses the full YAML, so lists like placeholders are available here (content.ts only reads the simple fields)
  frontmatter: Frontmatter & { placeholders?: Placeholder[] };
  headings?: { depth: number; slug: string; text: string }[];
}

// MDX pages pass their front matter to the layout as Astro.props.frontmatter, and their headings as Astro.props.headings
const { title, description, tags, updated, placeholders, sqlVersion, sqlNote } = Astro.props.frontmatter;

const path = normalisePath(Astro.url.pathname);
const section = SECTIONS.find((s) => s.key === path.split('/')[1]);

// Patterns and AI guides are the long reads: give them a reading time and contents
const LONG_READ_SECTIONS = ['patterns', 'ai'];
const longRead = section !== undefined && LONG_READ_SECTIONS.includes(section.key);
const minutes = longRead ? readingMinutes(path) : undefined;
const headings = longRead ? Astro.props.headings ?? [] : [];
const showToc = headings.some((h) => h.depth === 2);

// A "## Checks" section (every pattern has one) becomes a tick list with copy-to-ticket
const hasChecks = (Astro.props.headings ?? []).some((h) => h.depth === 2 && h.slug === 'checks');
---

<BaseLayout title={title} description={description} type="article" updated={updated}>
  <article class:list={['content-page', { 'has-toc': showToc }]} data-pagefind-body data-pagefind-filter={section ? `section:${section.name}` : undefined}>
    <header class="page-header">
      {section && <TypeLabel section={section.key} glyph />}
      <h1>{title}</h1>
      {description && <p class="description">{description}</p>}

      <dl class="facts">
        {updated && (
          <div>
            <dt>Updated</dt>
            <dd><time datetime={updated}>{formatDate(updated)}</time></dd>
          </div>
        )}
        {minutes && (
          <div>
            <dt>Reading time</dt>
            <dd>{minutes} min</dd>
          </div>
        )}
        {sqlVersion && (
          <div>
            <dt>Requires</dt>
            <dd title={`Runs on SQL Server ${sqlVersion} and later, Azure SQL Database and Azure SQL Managed Instance`}>{sqlVersionLabel(sqlVersion)}</dd>
          </div>
        )}
        {tags && tags.length > 0 && (
          <div class="tags">
            <dt>Tags</dt>
            <dd>
              {tags.map((tag) => (
                <a class="tag" href={tagPath(tag)} data-umami-event="tag-click" data-umami-event-target={`page-${tag}`}>{tag}</a>
              ))}
            </dd>
          </div>
        )}
        {section && (
          <div class="markdown">
            <dt>Markdown</dt>
            <dd><CopyMarkdown path={path} /></dd>
          </div>
        )}
      </dl>
      {sqlNote && <p class="sql-note"><strong>Requires:</strong> {sqlNote}</p>}
      {/* Search filter: one value per release the snippet runs on, so choosing "2014" finds everything that works there */}
      {sqlVersion && sqlVersionsFrom(sqlVersion).map((v) => (
        <span hidden data-pagefind-filter="Runs on SQL Server[data-version]" data-version={v}></span>
      ))}
    </header>

    <div class="page-body">
      {showToc && <TableOfContents headings={headings} />}
      <div class="content">
        {placeholders && placeholders.length > 0 && <PlaceholderPanel placeholders={placeholders} />}
        <slot />
      </div>
    </div>
    {hasChecks && <ChecksChecklist />}
    {section && <PageFeedback />}
    <PageEndNav path={path} />
  </article>
</BaseLayout>

<script>
  import { trackEvent } from '../scripts/analytics';

  // Each highlighted code block gets a caption bar with its language and a Copy button
  function addCodeBars() {
    document.querySelectorAll<HTMLPreElement>('.content pre.astro-code').forEach((pre, index) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';

      const bar = document.createElement('div');
      bar.className = 'code-bar';

      const language = document.createElement('span');
      language.className = 'code-language';
      language.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-button';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', `Copy ${language.textContent} code`);

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent || '');
          trackEvent('code-copy', {
            page: location.pathname,
            section: location.pathname.split('/')[1] || 'home',
            language: pre.dataset.language || 'text',
            block: index + 1,
          });
          button.textContent = 'Copied';
          button.classList.add('copied');
        } catch (err) {
          console.error('Failed to copy code:', err);
          button.textContent = 'Copy failed';
        }
        setTimeout(() => {
          button.textContent = 'Copy';
          button.classList.remove('copied');
        }, 2000);
      });

      bar.append(language, button);
      pre.before(wrapper);
      wrapper.append(bar, pre);
    });
  }

  addCodeBars();
</script>

<style>
  .content-page {
    max-width: calc(var(--prose-max) + 56px + 220px);
  }

  .page-header {
    max-width: var(--prose-max);
    margin-bottom: 8px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .page-header h1 {
    margin-top: 12px;
    color: var(--text-strong);
    font-size: 36px;
    line-height: var(--lh-h1);
    letter-spacing: var(--ls-h1);
    font-weight: 700;
  }

  .description {
    margin-top: 10px;
    color: var(--text-body);
    font-size: 18px;
    line-height: var(--lh-lead);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin-top: 20px;
    padding: 12px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }

  .facts dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .facts dd {
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 500;
  }

  .facts .tags dd {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
  }

  .facts .markdown { margin-left: auto; }

  .sql-note {
    margin-top: 12px;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    background: var(--warning-bg);
    color: var(--warning-fg);
    font-size: 14px;
  }

  .sql-note strong { font-weight: 600; }

  .page-body {
    display: grid;
    grid-template-columns: minmax(0, var(--prose-max));
    gap: 56px;
    align-items: start;
    margin-top: 32px;
  }

  .has-toc .page-body {
    grid-template-columns: minmax(0, var(--prose-max)) 220px;
  }

  .has-toc .page-body > :global(.toc) {
    grid-column: 2;
    grid-row: 1;
  }

  .content-page > :global(:not(.page-header):not(.page-body)) {
    max-width: var(--prose-max);
  }

  @media (max-width: 1199px) { /* matches TableOfContents: sidebar from 1200px */
    .has-toc .page-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .has-toc .page-body > :global(.toc) {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .page-header h1 { font-size: 29px; }
    .facts { gap: 10px 20px; }
    .facts .markdown { margin-left: 0; }
  }
</style>
