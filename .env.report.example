# Login for npm run report (scripts/content-report.mjs). Copy to .env.report (git-ignored) and fill in.
# The Umami address and website id come from .env.production.
#
# Use a view-only Umami user rather than admin: in Umami, Settings > Users > Create user with the
# "View only" role, then give it access to the WebDevRock website (Settings > Websites > WebDevRock > Share/Teams,
# depending on your Umami version).
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Umami Cloud instead: an API key, and the API address
# UMAMI_API_KEY=
# UMAMI_URL=https://api.umami.is/v1
